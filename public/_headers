# Cloudflare Pages also reads public/_headers when publish dir is .
# Netlify prefers root _headers or netlify.toml (we use netlify.toml).

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Public configurator embed — allow framing from company websites.
/public/*
  X-Frame-Options:
  Content-Security-Policy: frame-ancestors *
